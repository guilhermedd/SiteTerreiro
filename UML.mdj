										"$ref": "AAAAAAGXGpGGor5dTmo="
									},
									"name": "month_name",
									"specification": "  def month_name\n    months = {\n      1 => \"Janeiro\",\n      2 => \"Fevereiro\",\n      3 => \"Março\",\n      4 => \"Abril\",\n      5 => \"Maio\",\n      6 => \"Junho\",\n      7 => \"Julho\",\n      8 => \"Agosto\",\n      9 => \"Setembro\",\n      10 => \"Outubro\",\n      11 => \"Novembro\",\n      12 => \"Dezembro\",\n    }\n    months[event_date.month]\n  end"
								},
								{
									"_type": "UMLOperation",
									"_id": "AAAAAAGXGqfTUMxamG8=",
									"_parent": {
										"$ref": "AAAAAAGXGpGGor5dTmo="
									},
									"name": "start_time",
									"specification": "  def start_time\n    event_date\n  end"
								},
								{
									"_type": "UMLOperation",
									"_id": "AAAAAAGXGqgxpczFDWI=",
									"_parent": {
										"$ref": "AAAAAAGXGpGGor5dTmo="
									},
									"name": "get_day",
									"specification": "  def get_day\n    \"%.2d/%.2d/%d\" % [event_date.day, event_date.month, event_date.year]\n  end"
								}
							]
