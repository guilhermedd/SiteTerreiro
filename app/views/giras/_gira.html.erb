<% event_class = if gira.type_of_gira == "Aberto"
                      "event-open"
                    elsif gira.type_of_gira == "Fechado"
                      "event-closed"
                    elsif gira.type_of_gira == "Desenvolvimento"
                      "event-development"
                    elsif gira.type_of_gira == "Evento"
                      "event-other"
                    end
                 %>

<div class="col-6">
  <div class="card ">
    <h5 class="card-header"><%= gira.get_day %></h5>
    <div class="card-body ">
      <h5 class="card-title"><%= gira.name %></h5>

      <p class="card-text"><%= gira.description.gsub("\n", "<br>").html_safe %></p>

      <div class="card-text event <%= event_class %>">
        <strong><%= gira.type_of_gira %></strong>
      </div>
    </div>
  </div>
</div>