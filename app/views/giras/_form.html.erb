<%= form_with(model: gira) do |form| %>
  <% if gira.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(gira.errors.count, "error") %> prohibited this gira from being saved:</h2>

      <ul>
        <% gira.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3 justify-content-center">
    <div class="col-md-4">
      <%= form.label "Data do Evento", style: "display: block" %>
      <%= form.date_field :event_date, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= form.label "Nome do Evento", style: "display: block" %>
      <%= form.text_field :name, class: "form-control", autocomplete: "off" %>
    </div>

    <div class="col-8" style="max-width: 300px;">
      <%= form.label "Descrição", "Tipo de evento" %>
      <%= form.select :type_of_gira,
                      [["Gira aberta", "Aberto"], ["Gira fechado", "Fechado"], ["Desenvolvimento", "Desenvolvimento"], ["Outro evento", "Evento"]],
                      { prompt: "Selecione o tipo de evento" },
                      { class: "form-select", id: "type_of_gira_select" } %>
    </div>

    <div class="col-md-8">
      <%= form.label "Descrição", style: "display: block" %>
      <%= form.text_area :description, rows: 4, cols: 50, class: "form-control", id: "exampleFormControlTextarea1" %>
    </div>

    <div class="row justify-content-center py-3">
      <div class="col-auto">
        <%= form.submit "Confirmar Evento", class: "btn btn-primary btn-lg" %>
      </div>
    </div>


    <div class="row-6 d-flex justify-content-center">
      <%= link_to "Cancelar", root_path, class: "btn btn-danger btn-lg", data: { turbo: "false", turbo_confirm: "Tem certeza que deseja cancelar?" } %>
    </div>

  </div>
<% end %>
