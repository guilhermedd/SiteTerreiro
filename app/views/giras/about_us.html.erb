<% content_for :title, "Sobre Nós" %>

<div class="container py-5">
  <div class="row text-center">
    <h1 class="display-4 fw-bold">Sobre Nós</h1>
    <p class="lead text-muted">Conheça um pouco mais sobre nosso trabalho e nossa missão.</p>
  </div>

  <div class="row pt-4">
    <%= render "about_us/atendimento" %>

    <%= render "about_us/cura" %>
  </div>

  <div class="row pt-4">
    <%= render "about_us/apometria" %>

    <%= render "about_us/social" %>
  </div>

  <div class="row pt-4">
    <%= render "about_us/sopa" %>

    <%= render "about_us/cesta" %>
  </div>
</div>

<style>
    .work {
        transition: transform 0.3s ease-in-out; /* Suaviza a transição para o aumento */
    }

    .work:hover {
        transform: scale(1.2); /* Aumenta o tamanho do link inteiro */
    }

    .offcanvas-backdrop {
        background-color: rgba(0, 0, 0, 0.5); /* Ajuste a opacidade conforme necessário */
    }
</style>
