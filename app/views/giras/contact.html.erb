<div class="container d-flex justify-content-center py-5">
  <div class="w-50 border p-4 rounded shadow">
    <h1 class="d-flex justify-content-center display-4 fw-bold">Nos Contate</h1>
    <div class="control">
      <%= form_with url: send_contact_giras_path, method: :post do |f| %>
        <div class="mb-3">
          <%= f.label :name, "Nome Completo" %>
          <%= f.text_field :name, class: "form-control", placeholder: "Lucas da Silva" %>
        </div>

        <div class="mb-3">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, class: "form-control", placeholder: "lucas@gmail.com" %>
        </div>

        <div class="mb-3">
          <%= f.label :subject, "Assunto do email" %>
          <%= f.text_field :subject, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :message, "Sua mensagem" %>
          <%= f.text_area :message, class: "form-control", rows: 3 %>
        </div>

        <div class="d-flex justify-content-center mt-3">
          <%= f.submit "Enviar", class: "btn btn-primary btn-lg" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
