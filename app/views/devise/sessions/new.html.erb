<div class="container d-flex justify-content-center py-5">
  <div class="w-50 w-50 border p-4 rounded shadow">
    <h2 class="py-5 text-center">Entrar</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="row g-3 d-flex flex-column align-items-center">

        <div class="field w-100 text-center">
          <%= f.label :email %><br />
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>

        <div class="field w-100 text-center">
          <%= f.label "Senha" %><br />
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="form-check w-100 d-flex justify-content-center align-items-center">
            <%= f.check_box :remember_me, class: "form-check-input", id: "flexCheckDefault" %>
            <%= f.label :remember_me, "Lembrar de mim", class: "form-check-label ms-2", for: "flexCheckDefault" %>
          </div>
        <% end %>


        <div class="actions w-100 text-center">
          <%= f.submit "Log in", class: "btn btn-primary w-100" %>
        </div>
      </div>
    <% end %>

    <div class="py-5 w-100 text-center">
        <%= render "devise/shared/links" %>
    </div>


  </div>
</div>
