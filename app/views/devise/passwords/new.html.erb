<div class="container d-flex justify-content-center py-5">
  <div class="w-50 border p-4 rounded shadow">
    <h2 class="pt-5 text-center">Esqueceu sua senha?</h2>
    <h3 class="pb-5 text-center">(ainda em desenvolvimento)</h3>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <div class="row g-3 d-flex flex-column align-items-center">

        <div class="field w-100 text-center">
          <%= f.label :email %><br />
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>

        <div class="actions w-100 text-center">
          <%= f.submit "Send me reset password instructions", class: "btn btn-primary w-100" %>
        </div>
      </div>
    <% end %>

    <div class="py-5 w-100 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
