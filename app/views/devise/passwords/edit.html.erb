<div class="container d-flex justify-content-center py-5">
  <div class="w-50 border p-4 rounded shadow">
    <h2 class="py-5 text-center">Mudar sua Senha</h2>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <div class="row g-3 d-flex flex-column align-items-center">

        <%= render "devise/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="field w-100 text-center">
          <%= f.label :password, "Nova senha" %><br />
          <% if @minimum_password_length %>
            <em>(Mínimo de <%= @minimum_password_length %> caracteres)</em><br />
          <% end %>
          <%= f.password_field :password, autofocus: true, autocomplete: "nova-senha", class: "form-control" %>
        </div>

        <div class="field w-100 text-center">
          <%= f.label :password_confirmation, "Confirmar nova senha" %><br />
          <%= f.password_field :password_confirmation, autocomplete: "nova-senha", class: "form-control" %>
        </div>

        <div class="actions w-100 text-center">
          <%= f.submit "Mudar minha senha", class: "btn btn-primary w-50" %>
        </div>
      </div>
    <% end %>

    <div class="py-5 w-100 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
