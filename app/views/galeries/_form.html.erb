<%= form_with model: @galery, html: { multipart: true } do |form| %>
  <% if @galery.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@galery.errors.count, "error") %> prohibited this galery from being saved:</h2>
      <ul>
        <% @galery.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :authenticity_token, value: form_authenticity_token %>  <!-- Inclui o token CSRF -->

  <%= form.label :title, "Título da Galeria" %>
  <%= form.text_field :title, class: "form-control" %>

  <div class="field w-100 pt-3">
    <%= form.label :images, "Imagens" %>
    <%= form.file_field :images, multiple: true, class: "form-control" %>  <!-- Allow multiple files -->
  </div>

  <div id="new_photos"></div>

  <% if not @galery.images.blank? %>
    <h4 class="pt-3">Imagens adicionadas:</h4>

    <div class="field w-100 pt-3 d-flex justify-content-start align-items-center flex-wrap">
      <% @galery.images.each do |image| %>
        <div class="w-100 py-1">
          <div class="d-flex align-items-center mx-2">
            <p class="mb-0 me-2"><%= image.filename.to_s %></p>
            <div class="position-relative" style="width: 50px; height: 50px">

              <div class="placeholder w-100 h-100 placeholder-wave bg-secondary position-absolute top-0 start-0 px-1"></div>

              <%= image_tag image.variant(resize_to_fill: [50, 50]).processed,
                            onload: "this.previousElementSibling.remove()",
                            class: "me-2 position-relative px-1",
                            width: "50",
                            height: "50" %>
            </div>
            <%= link_to "Excluir", detach_image_galery_path(@galery, image_id: image.id),
                        method: :delete,
                        data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja remover esta imagem?" },
                        class: "btn btn-danger btn-sm" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div id="pessoas-container">
    <div id="image-previews" class="d-flex flex-wrap"></div> <!-- Container para miniaturas -->

    <div class="py-3 d-flex justify-content-evenly">
      <button id="meuBotao" type="button" class="btn btn-primary btn-lg mt-2">
        Adicionar mais fotos
      </button>

      <%= form.submit "Salvar Galeria", class: "btn btn-success btn-lg mt-2" %>
    </div>
  </div>

<% end %>

<style>
    .placeholder-container:has(+ img) { display: none; }
</style>